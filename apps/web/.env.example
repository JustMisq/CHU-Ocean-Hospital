# Copier ce fichier en `.env.local` et remplir les valeurs.
# Les grades, services et spécialités se configurent sur le site (/pro/config).

# Base Postgres (Vercel > Storage > Neon). Même URL dans packages/db/.env
DATABASE_URL="postgresql://user:password@host/db?sslmode=verify-full"

# Auth.js — générer avec : npx auth secret
AUTH_SECRET=""

# Connexion de test sans mot de passe (comptes de démo du seed).
# Jamais en production.
AUTH_DEV_LOGIN="true"

# Fuseau horaire du serveur RP
NEXT_PUBLIC_TZ="Europe/Paris"
