# Copier ce fichier en `.env.local` et remplir les valeurs.
# Les grades, services, spécialités et IDs de rôles Discord se configurent sur le site (/pro/config).

# Base Postgres (Vercel > Storage > Neon). Même URL dans packages/db/.env
DATABASE_URL="postgresql://user:password@host/db?sslmode=verify-full"

# Auth.js — générer avec : npx auth secret
AUTH_SECRET=""

# ─── Discord (OPTIONNEL) ───────────────────────────────────────────────
# Laissés vides : connexion par identifiant + mot de passe uniquement, tout ce qui touche
# à Discord est masqué. Remplis : bouton « Continuer avec Discord » + synchro des rôles.
# Application : https://discord.com/developers/applications > OAuth2
# Redirect URI à déclarer : http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
# Super-admins par ID Discord (sinon : npm run admin -- <identifiant> <motdepasse>)
ADMIN_DISCORD_IDS=""
# ID du serveur Discord (secours : la valeur réglée dans /pro/config est prioritaire)
DISCORD_GUILD_ID=""

# Connexion de test sans mot de passe (comptes de démo du seed).
# En production : seulement le temps de configurer Discord, puis supprimer.
AUTH_DEV_LOGIN="true"

# Fuseau horaire du serveur RP
NEXT_PUBLIC_TZ="Europe/Paris"
