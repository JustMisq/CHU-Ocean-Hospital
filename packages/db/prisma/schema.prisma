// Schéma Ocean Hospital.
// Base Postgres (la même URL en local et sur Vercel, voir README).
//
// Tout ce qui structure l'hôpital (services, grades, spécialités, réglages) est
// configurable depuis le site et attribué à la main dans /pro/personnel.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

/// Réglages clé/valeur modifiables depuis /pro/config.
model Setting {
  key   String @id
  value String
}

/// Compte du site. Connexion par identifiant + mot de passe.
model User {
  id                 String    @id @default(cuid())
  /// Identifiant de connexion (minuscules).
  login              String?   @unique
  passwordHash       String?
  /// Mot de passe temporaire donné par la direction : à changer à la prochaine connexion.
  mustChangePassword Boolean   @default(false)
  /// Accès total, même sans grade (créé avec `npm run admin`).
  isSuperAdmin       Boolean   @default(false)
  /// Anti-force brute : compte bloqué 15 min après 5 échecs.
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  /// Nom affiché (choisi à l'inscription ou par la direction).
  username           String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  characters    Character[]
  staff         StaffProfile?
  auditLogs     AuditLog[]
  notifications Notification[]
}

/// Personnage RP (= dossier patient). Un compte peut en avoir plusieurs ; le premier est créé avec le compte.
/// Un personnage qui a des RDV n'est jamais supprimé, seulement archivé (le dossier médical reste).
/// Sans `userId` : dossier créé par un soignant pour quelqu'un qui n'a pas (encore) de compte, rattaché plus tard.
model Character {
  id            String    @id @default(cuid())
  userId        String?
  firstName     String
  lastName      String
  /// Infos complémentaires facultatives : complétées plus tard par le joueur ou par un soignant.
  birthDate     DateTime?
  phone         String?
  bloodType     String?
  allergies     String?
  /// "M", "F" ou "X" (autre).
  sex           String?
  /// Numéro affiché sur les documents (ex : PAT-202607-6436), attribué au premier document.
  patientNumber String?   @unique
  /// Renseigné par un certificat de décès (effacé si le certificat est annulé).
  deceasedAt    DateTime?
  /// Patient non identifié (« INCONNU X-0003 ») : ce qu'on observe à la place de l'état civil.
  apparentAge   String?
  description   String?
  createdAt     DateTime  @default(now())
  archivedAt    DateTime?

  user         User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  documents    MedicalDocument[]
  requests     ServiceRequest[]

  @@index([userId])
}

/// Service / département de l'hôpital (affiché publiquement).
model Service {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String  @default("")
  icon        String  @default("stethoscope")
  order       Int     @default(0)
  isPublic    Boolean @default(true)
  /// Préfixe des numéros d'ordonnance (ex : KINE → KINE-202609-0001). Vide : ORD.
  code        String  @default("")
  /// Chef de service, affiché dans l'en-tête des ordonnances.
  headId      String?

  // Nom explicite = nom par défaut : la table de liaison existante (_ServiceToStaffProfile) est conservée.
  staff        StaffProfile[]    @relation("ServiceToStaffProfile")
  head             StaffProfile?     @relation("ServiceHead", fields: [headId], references: [id], onDelete: SetNull)
  appointments     Appointment[]
  documents        MedicalDocument[]
  requestTypes     RequestType[]
  sentRequests     ServiceRequest[]  @relation("RequestFrom")
  receivedRequests ServiceRequest[]  @relation("RequestTo")
}

/// Compétence complémentaire (ex : chirurgien, psychiatre, formateur…).
model Specialty {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String @default("")
  order       Int    @default(0)

  staff StaffProfile[]
}

/// Grade hiérarchique. `order` élevé = grade supérieur. Porte les permissions.
model Grade {
  id          String  @id @default(cuid())
  name        String
  order       Int     @default(0)
  color       String  @default("#0a6f98")
  /// Peut publier des disponibilités et apparaître dans l'annuaire.
  bookable    Boolean @default(true)
  /// Permissions (clés séparées par des virgules, voir permissions.ts).
  permissions String  @default("")

  staff StaffProfile[]
}

/// Fiche d'un membre du personnel.
model StaffProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  displayName  String
  bio          String?
  /// Photo et bannière envoyées par le soignant (`/api/images/<id>`). Sans photo : initiales.
  photoUrl     String?
  bannerUrl    String?
  gradeId      String?
  /// Choix du soignant : apparaître ou non dans l'annuaire.
  isPublic     Boolean  @default(true)
  /// Choix de la direction : null = selon le grade, true / false = forcé pour ce membre.
  bookable     Boolean?
  /// Titre affiché sous le nom sur les documents (ex : « Masseur-kinésithérapeute D.E. »).
  jobTitle     String?
  /// Signature dessinée dans « Mon profil » (PNG transparent), apposée sur les ordonnances.
  signatureUrl String?
  createdAt    DateTime @default(now())

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade          Grade?            @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  services       Service[]         @relation("ServiceToStaffProfile")
  headOf         Service[]         @relation("ServiceHead")
  specialties    Specialty[]
  availabilities   Availability[]
  appointments     Appointment[]
  documents        MedicalDocument[]
  authoredRequests ServiceRequest[] @relation("RequestAuthor")
  directRequests   ServiceRequest[] @relation("RequestRecipient")
  assignedRequests ServiceRequest[] @relation("RequestAssignee")
  requestEvents    RequestEvent[]
}

/// Plage de disponibilité publiée par un soignant, découpée en créneaux de `slotMinutes`.
model Availability {
  id          String   @id @default(cuid())
  staffId     String
  start       DateTime
  end         DateTime
  slotMinutes Int      @default(30)
  createdAt   DateTime @default(now())

  staff StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, start])
}

model Appointment {
  id           String            @id @default(cuid())
  characterId  String
  staffId      String
  serviceId    String?
  start        DateTime
  end          DateTime
  reason       String
  status       AppointmentStatus @default(CONFIRMED)
  /// Compte rendu rédigé par le soignant (visible du patient).
  report       String?
  cancelReason String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Restrict : un RDV (et son compte rendu) ne disparaît jamais par effet de bord.
  character Character         @relation(fields: [characterId], references: [id], onDelete: Restrict)
  staff     StaffProfile      @relation(fields: [staffId], references: [id], onDelete: Restrict)
  service   Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  documents MedicalDocument[]

  @@index([staffId, start])
  @@index([characterId])
}

/// Types de documents (libellés, champs et texte imprimé : apps/web/src/lib/document-types.ts).
enum DocumentKind {
  ORDONNANCE
  EXAMENS
  CERTIFICAT
  ARRET_TRAVAIL
  DECES
  REFUS_SOINS
  REFUS_SIGNATURE
  IMAGERIE

  @@map("PrescriptionKind")
}

/// Document médical (ordonnance, certificat, arrêt de travail…), rattaché au dossier du patient. Jamais modifié après
/// émission : `snapshot` fige l'en-tête (patient, soignant, service, signature) pour que le PDF reste identique dans le temps.
/// Table historique « Prescription » conservée (@@map) : les documents déjà émis restent en place.
model MedicalDocument {
  id             String       @id @default(cuid())
  /// Ex : KINE-202609-0001 (préfixe du service ou du type, mois, numéro du mois).
  number         String       @unique
  kind           DocumentKind @default(ORDONNANCE)
  characterId    String
  staffId        String
  serviceId      String?
  appointmentId  String?
  /// Lignes : [{ name, instructions, quantity }].
  items          Json         @default("[]")
  /// Texte libre (certificat, remarques).
  body           String       @default("")
  /// Champs propres au type de document (dates d'arrêt, cause du décès, soins refusés…).
  data           Json         @default("{}")
  renewable      Boolean      @default(false)
  validityMonths Int          @default(3)
  snapshot       Json
  createdAt      DateTime     @default(now())
  revokedAt      DateTime?
  revokedReason  String?

  character   Character        @relation(fields: [characterId], references: [id], onDelete: Restrict)
  staff       StaffProfile     @relation(fields: [staffId], references: [id], onDelete: Restrict)
  service     Service?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  appointment Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  /// Demandes auxquelles ce document répond (compte rendu d'imagerie, résultats…).
  answers     ServiceRequest[] @relation("RequestDocument")

  @@index([characterId])
  @@map("Prescription")
}

// ─── Demandes entre services, transferts, notifications ──────────────────────

enum RequestKind {
  /// Demande à un service (analyse, avis, intervention…).
  DEMANDE
  /// Transfert du patient vers un service, qui le prend en charge.
  TRANSFERT
}

enum RequestStatus {
  /// Envoyée, en attente du service.
  PENDING
  /// Acceptée / prise en charge (fin du parcours pour un transfert).
  ACCEPTED
  REFUSED
  /// Traitée : réponse rendue.
  COMPLETED
  /// Retirée par le demandeur.
  CANCELLED
}

enum RequestPriority {
  NORMAL
  URGENT
  /// Urgence vitale.
  VITAL
}

/// Type de demande qu'un service accepte, configurable par la direction ou le chef de service.
/// Les formulaires sont des listes de champs : [{ name, label, type, required, options, half, hint }].
model RequestType {
  id                String        @id @default(cuid())
  serviceId         String
  name              String
  description       String        @default("")
  order             Int           @default(0)
  active            Boolean       @default(true)
  /// Rempli par le demandeur.
  fields            Json          @default("[]")
  /// Rempli par le service pour accepter (réquisition, consultation…). Vide : acceptation en un clic.
  acceptFields      Json          @default("[]")
  /// Rempli par le service en clôturant (résultats, avis…).
  responseFields    Json          @default("[]")
  /// Documents que le patient doit déjà avoir (types séparés par des virgules, ex : DECES).
  requiredDocuments String        @default("")
  /// Demandes déjà traitées pour ce patient (ids de types séparés par des virgules), ex : consultation d'anesthésie.
  requiredTypes     String        @default("")
  /// Document attendu en réponse (ex : IMAGERIE) : rédigé depuis la demande et rattaché à elle.
  responseDocument  DocumentKind?
  createdAt         DateTime      @default(now())

  service  Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  requests ServiceRequest[]

  @@index([serviceId])
}

/// Demande d'un soignant à un service, ou transfert de patient. Le type et ses formulaires sont figés à l'envoi.
model ServiceRequest {
  id                 String          @id @default(cuid())
  /// Ex : DEM-202610-0001 / TRF-202610-0001.
  number             String          @unique
  kind               RequestKind     @default(DEMANDE)
  typeId             String?
  /// Nom et formulaires du type au moment de l'envoi.
  typeSnapshot       Json            @default("{}")
  characterId        String
  authorId           String
  fromServiceId      String?
  toServiceId        String
  /// Destinataire précis (facultatif) ; sinon tout le service.
  recipientId        String?
  /// Soignant qui a pris la demande en charge.
  assigneeId         String?
  priority           RequestPriority @default(NORMAL)
  status             RequestStatus   @default(PENDING)
  /// Motif / message du demandeur.
  message            String          @default("")
  data               Json            @default("{}")
  acceptData         Json            @default("{}")
  responseData       Json            @default("{}")
  response           String          @default("")
  refusalReason      String?
  responseDocumentId String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  acceptedAt         DateTime?
  closedAt           DateTime?

  type             RequestType?     @relation(fields: [typeId], references: [id], onDelete: SetNull)
  character        Character        @relation(fields: [characterId], references: [id], onDelete: Restrict)
  author           StaffProfile     @relation("RequestAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  fromService      Service?         @relation("RequestFrom", fields: [fromServiceId], references: [id], onDelete: SetNull)
  toService        Service          @relation("RequestTo", fields: [toServiceId], references: [id], onDelete: Restrict)
  recipient        StaffProfile?    @relation("RequestRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  assignee         StaffProfile?    @relation("RequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  responseDocument MedicalDocument? @relation("RequestDocument", fields: [responseDocumentId], references: [id], onDelete: SetNull)
  events           RequestEvent[]
  notifications    Notification[]

  @@index([toServiceId, status])
  @@index([characterId])
  @@index([authorId])
}

/// Fil d'une demande : envoi, acceptation, messages échangés, clôture.
model RequestEvent {
  id        String   @id @default(cuid())
  requestId String
  staffId   String?
  /// create | accept | refuse | complete | cancel | comment | document | assign
  action    String
  message   String   @default("")
  createdAt DateTime @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  staff   StaffProfile?  @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
}

/// Notification affichée sur le site (cloche de l'en-tête), pour soignants comme pour patients.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String    @default("")
  /// Page à ouvrir.
  link      String
  requestId String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  request ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

/// Image envoyée depuis le site (photo, bannière), déjà redimensionnée par le navigateur.
/// Stockée en base pour n'avoir aucun service de stockage à configurer. Servie par /api/images/[id].
model Image {
  id        String   @id @default(cuid())
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
}

/// Journal des actions du personnel (qui a fait quoi), consultable dans /pro/journal.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  /// Résumé lisible de la cible et du changement (ex : « Dr. Hale → Médecin »).
  summary   String
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
